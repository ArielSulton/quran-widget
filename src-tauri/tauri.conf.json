{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simak",
  "mainBinaryName": "simak",
  "version": "0.1.0",
  "identifier": "app.simak.ayat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Simak",
        "width": 520,
        "height": 320,
        "minWidth": 430,
        "minHeight": 270,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "transparent": true,
        "shadow": false,
        "windowEffects": { "effects": ["underWindowBackground"], "state": "active", "radius": 18 }
      }
    ],
    "macOSPrivateApi": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "homepage": "https://arielsulton.web.id/apps/simak",
    "shortDescription": "Ayat Al-Qur'an yang sedang dibacakan di Spotify",
    "longDescription": "Simak adalah widget desktop kecil yang menampilkan ayat Al-Qur'an beserta terjemahan Indonesia (Kemenag) yang sedang dibacakan pada trek Juz 30 di aplikasi Spotify. Ayat berganti mengikuti posisi pemutaran.",
    "copyright": "© Simak contributors",
    "resources": {
      "../data/timing/": "data/timing/",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../data/quran/NOTICE.md": "data/quran/NOTICE.md",
      "../src/assets/fonts/OFL.txt": "licenses/AmiriQuran-OFL.txt"
    },
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0"] }
    }
  }
}
