{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simak",
  "version": "0.1.0",
  "identifier": "app.simak.ayat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Simak",
        "width": 520,
        "height": 320,
        "minWidth": 340,
        "minHeight": 210,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "transparent": true,
        "shadow": false,
        "windowEffects": { "effects": ["underWindowBackground"], "state": "active", "radius": 18 }
      }
    ],
    "macOSPrivateApi": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": { "../data/timing/": "data/timing/" }
  }
}
