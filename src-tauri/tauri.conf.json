{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quran Widget",
  "version": "0.1.0",
  "identifier": "dev.quranwidget.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quran Widget",
        "width": 480,
        "height": 260,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "transparent": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
